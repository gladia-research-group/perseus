+// ── fault injection (throwaway branch em-z5-fault, never in a PR) ──────────────────────────────────────────────────
+
+/// `/tmp/pc_fault.txt` = "k log2_rate": `small_int` shifts the overflow integer of part 0's coefficients of index 0 mod
+/// 128 (those every route keeps) by +-k, each with probability 2^-log2_rate, chosen by a hash of its own residues.
+pub fn fault_cfg() -> Option<(i64, u32)> {
+    let s = std::fs::read_to_string("/tmp/pc_fault.txt").ok()?;
+    let mut it = s.split_whitespace();
+    let (k, l) = (it.next()?.parse().ok()?, it.next()?.parse().ok()?);
+    eprintln!("[pc-fault] k {k}, log2 rate {l}");
+    Some((k, l))
+}
+
+/// Arms a table: the unused `pad` holds the rate, the unused last word of `pow32` the residue of round(c k Qd).
+pub fn set_fault(tab: &mut SmallIntTab, q: &[u64], top: usize, c: f64, k: i64, log2_rate: u32) {
+    let qd = q[0] as i128 * q[1] as i128;
+    // c = 1 (lift only): exact, since Qd does not fit a double's mantissa; the production c Qd (~2^46) does
+    let delta = if c == 1.0 { k as i128 * qd } else { (c * k as f64 * qd as f64).round() as i128 };
+    tab.pad = log2_rate as i32;
+    for (o, &p) in q.iter().enumerate().take(top + 1) {
+        tab.pow32[o][SI_MAXW + SI_MAXR - 1] = delta.rem_euclid(p as i128) as u32;
+    }
+}
