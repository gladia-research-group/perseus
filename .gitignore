__pycache__/
*.egg-info/
*pyc
.venv/
.claude/
*.python-version
*lock
!uv.lock

# build trees and dependency checkouts (both are chain-suffixed: deps_n32, build_py_n64)
build/
build-*/
build_*/
deps/
deps_n*/
_deps/
Testing/
*.o
*.so*
*.bak*
# vendored toolchain for a machine without system cmake/NCCL headers
.local_deps

# run products
logs/
.cache/
weights*/
weights.bin.zip

# generated assets under docs/ are local; the documentation itself is tracked
docs/*
!docs/*.md

# JSON is a run product by default; the tracked exceptions are the artifacts the paper needs
*.csv
*.json
!perseus/**/*.json
!tests/fixtures/**/*.json
!bootstrap_placements/**/*.json
!graphs/**/*.json
# scratch plan directories from an A/B are named with a leading underscore
bootstrap_placements/_*/
