__pycache__/
*.egg-info/
*pyc
.venv/
.claude/
*.python-version
*lock
!uv.lock

# build trees and dependency checkouts (both are chain-suffixed: deps_n32, build_py_n64)
build/
build-*/
build_*/
deps/
deps_n*/
_deps/
Testing/
*.o
*.so*
*.bak*
# vendored toolchain for a machine without system cmake/NCCL headers
.local_deps

# run products
logs/
.cache/
weights*/
weights.bin.zip
notebooks/*_executed.ipynb
notebooks/*.error.txt

# local, not in the repository: the docs and the paper repositories
docs/
paper-org/
paper-workshop/

# JSON is a run product by default; the tracked exceptions are the artifacts the paper needs
*.csv
*.json
!perseus/**/*.json
!tests/fixtures/**/*.json
!bootstrap_placements/**/*.json
!graphs/**/*.json
# scratch plan directories from an A/B are named with a leading underscore
bootstrap_placements/_*/

# Rust / CUDA build trees and profiler output
/target
/target-*
**/target/
/out
*.nsys-rep
*.sqlite
*.ncu-rep
!Cargo.lock
!python/**/*.json
!crates/**/*.json

# Llama recordings: not in the repository, recorded by the user (graphs/LLAMA.txt)
graphs/llama31_8b_*
