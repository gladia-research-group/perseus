diff --git a/src/pke/lib/keyswitch/keyswitch-hybrid.cpp b/src/pke/lib/keyswitch/keyswitch-hybrid.cpp
index 552fee8f..fd9eb680 100644
--- a/src/pke/lib/keyswitch/keyswitch-hybrid.cpp
+++ b/src/pke/lib/keyswitch/keyswitch-hybrid.cpp
@@ -43,8 +43,48 @@
 #include "scheme/ckksrns/ckksrns-cryptoparameters.h"
 #include "ciphertext.h"
 
+// KSKA seed expansion (FIDESlib Lever 1b-ii): utils/kskseedexpand.h MUST stay byte-identical
+// to FIDESlib's src/CKKS/KskSeedExpand.cuh (the GPU regenerates `a` from the same seed; the
+// install script cmp-guards the two copies, test_ksk_seed_expand gates the semantics).
+#include "utils/kskseedexpand.h"
+#include "math/distributiongenerator.h"
+
+#include <cstdlib>
+
 namespace lbcrypto {
 
+namespace {
+
+// Kill switch: OPENFHE_KSKA_SEED=0 restores the conventional dug-drawn `a` (seedless keys;
+// the GPU import then loads `a` densely as before).
+bool KskaSeedEnabled() {
+    static const bool v = [] {
+        const char* e = std::getenv("OPENFHE_KSKA_SEED");
+        return e == nullptr || std::atoi(e) != 0;
+    }();
+    return v;
+}
+
+// Expand one hybrid-keyswitch digit's `a` over paramsQP, directly in EVALUATION format —
+// exactly what DCRTPoly(dug, paramsQP, Format::EVALUATION) produces distribution-wise, but
+// deterministic from (seed, part, modulus, slot) and reproducible on the GPU.
+DCRTPoly SeededKskA(const uint32_t* seed, uint32_t part, const std::shared_ptr<DCRTPoly::Params>& paramsQP) {
+    DCRTPoly a(paramsQP, Format::EVALUATION, true);
+    const uint32_t N   = paramsQP->GetRingDimension();
+    const uint32_t n16 = N >> 4;
+    const auto& parms  = paramsQP->GetParams();
+    for (size_t i = 0; i < parms.size(); ++i) {
+        const uint32_t p = parms[i]->GetModulus().template ConvertToInt<uint32_t>();
+        DCRTPoly::PolyType poly(parms[i], Format::EVALUATION, true);
+        for (uint32_t s = 0; s < N; ++s)
+            poly[s] = FIDESlib::CKKS::kskexpand::expand_coeff(seed, part, p, s, n16);
+        a.SetElementAtIndex(i, std::move(poly));
+    }
+    return a;
+}
+
+}  // namespace
+
 EvalKey<DCRTPoly> KeySwitchHYBRID::KeySwitchGenInternal(const PrivateKey<DCRTPoly> oldKey,
                                                         const PrivateKey<DCRTPoly> newKey) const {
     return KeySwitchHYBRID::KeySwitchGenInternal(oldKey, newKey, nullptr);
@@ -99,9 +139,28 @@ EvalKey<DCRTPoly> KeySwitchHYBRID::KeySwitchGenInternal(const PrivateKey<DCRTPol
     std::vector<NativeInteger> PModq = cryptoParams->GetPModq();
     size_t numPerPartQ               = cryptoParams->GetNumPerPartQ();
 
+    // KSKA seed expansion: one 256-bit seed per key (Blake2 CSPRNG), every part's `a`
+    // expanded from it. Only when all QP moduli fit u32 (the expander is u32-wide);
+    // otherwise / under OPENFHE_KSKA_SEED=0 / for threshold HE the key stays seedless.
+    std::vector<uint32_t> aSeed;
+    if (KskaSeedEnabled() && ekPrev == nullptr) {
+        bool fits32 = true;
+        for (auto& prm : paramsQP->GetParams())
+            if (prm->GetModulus().template ConvertToInt<uint64_t>() > 0xFFFFFFFFull)
+                fits32 = false;
+        if (fits32) {
+            PRNG& prng = PseudoRandomNumberGenerator::GetPRNG();
+            aSeed.resize(8);
+            for (auto& w : aSeed)
+                w = static_cast<uint32_t>(prng());
+        }
+    }
+
     for (size_t part = 0; part < numPartQ; ++part) {
-        DCRTPoly a = (ekPrev == nullptr) ? DCRTPoly(dug, paramsQP, Format::EVALUATION) :  // single-key HE
-                                           ekPrev->GetAVector()[part];                                      // threshold HE
+        DCRTPoly a = (ekPrev != nullptr) ? ekPrev->GetAVector()[part]  // threshold HE
+                     : (!aSeed.empty())
+                         ? SeededKskA(aSeed.data(), static_cast<uint32_t>(part), paramsQP)  // seed-expanded
+                         : DCRTPoly(dug, paramsQP, Format::EVALUATION);  // single-key HE, conventional
         DCRTPoly e(dgg, paramsQP, Format::EVALUATION);
         DCRTPoly b(paramsQP, Format::EVALUATION, true);
 
@@ -131,6 +190,8 @@ EvalKey<DCRTPoly> KeySwitchHYBRID::KeySwitchGenInternal(const PrivateKey<DCRTPol
     ek->SetAVector(std::move(av));
     ek->SetBVector(std::move(bv));
     ek->SetKeyTag(newKey->GetKeyTag());
+    if (!aSeed.empty())
+        ek->SetASeed(std::move(aSeed));
     return ek;
 }
 
