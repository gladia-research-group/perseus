+                        (scalTech == FLEXIBLEAUTOEXT);
+        if (!isComposite && level + 1 < numQ) {
             double qDrop    = cryptoParams->GetModReduceFactor(numQ - 1 - level);
             double boundary = cryptoParams->GetScalingFactorReal(level + 1) * qDrop / scFact;
             // keep the original value (bit-identical) inside uniform segments; the
@@ -3690,6 +3741,33 @@ void FHECKKSRNS::FitToNativeVector(uint32_t ringDim, const std::vector<int64_t>&
                                    NativeVector* nativeVec) const {
     if (nativeVec == nullptr)
         OPENFHE_THROW("The passed native vector is empty.");
+#if NATIVEINT == 32
+    // Exact twin of the CKKSPackedEncoding::FitToNativeVector fix: MakeAuxPlaintext hands us
+    // int64_t coefficients in [0, bigBound) with bigBound = Max64BitValue() ~ 2^63 (negatives
+    // stored as bigBound + x). With NativeInteger = uint32_t, NativeInteger(vec[i]),
+    // bigValueHf = bigBound >> 1 and diff = bigBound - modulus all truncate, so every
+    // coefficient gets a garbage CRT residue. This overload encodes the bootstrap DFT
+    // matrices (CoeffsToSlots / SlotsToCoeffs), so leaving it unfixed makes every bootstrap
+    // linear transform garbage even when the encoder twin is correct.
+    // Do the sign split and the reduction in 64-bit arithmetic; narrow only at the store.
+    const int64_t bigValueHf = bigBound >> 1;
+    const uint64_t modulus   = nativeVec->GetModulus().ConvertToInt();
+    const uint32_t dslots    = vec.size();
+    const uint32_t gap       = ringDim / dslots;
+    for (uint32_t i = 0; i < vec.size(); i++) {
+        const int64_t val = vec[i];
+        uint64_t reduced;
+        if (val > bigValueHf) {
+            // val encodes the negative value (val - bigBound); reduce its magnitude and negate.
+            const uint64_t mag = static_cast<uint64_t>(bigBound - val) % modulus;
+            reduced            = (mag == 0) ? 0 : (modulus - mag);
+        }
+        else {
+            reduced = static_cast<uint64_t>(val) % modulus;
+        }
+        (*nativeVec)[gap * i] = NativeInteger(static_cast<uint32_t>(reduced));
+    }
+#else
     NativeInteger bigValueHf(bigBound >> 1);
     NativeInteger modulus(nativeVec->GetModulus());
     NativeInteger diff = bigBound - modulus;
@@ -3704,6 +3782,7 @@ void FHECKKSRNS::FitToNativeVector(uint32_t ringDim, const std::vector<int64_t>&
             (*nativeVec)[gap * i] = n.Mod(modulus);
         }
     }
+#endif
 }
 
