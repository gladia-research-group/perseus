+        }
+        else {
+            // RNS basis extension from level 0 RNS limbs to the raised RNS basis
+            auto& ctxtDCRT = raised->GetElements();
+            ExtendCiphertext(ctxtDCRT, *cc, elementParamsRaisedPtr);
+            raised->SetLevel(L0 - ctxtDCRT[0].GetNumOfElements());
