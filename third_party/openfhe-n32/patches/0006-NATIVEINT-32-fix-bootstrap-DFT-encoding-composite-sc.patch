             double boundary = cryptoParams->GetScalingFactorReal(level + 1) * qDrop / scFact;
             // keep the original value (bit-identical) inside uniform segments; the
@@ -3422,9 +3463,19 @@ Plaintext FHECKKSRNS::MakeAuxPlaintext(const CryptoContextImpl<DCRTPoly>& cc, co
     // in a mixed-size chain it absorbs the segment-boundary scale jumps.
     double scFact = cryptoParams->GetScalingFactorReal(level);
     {
+        const auto scalTech = cryptoParams->GetScalingTechnique();
+        // COMPOSITESCALING* stores a SENTINEL 1 in m_scalingFactorsReal at every level index
