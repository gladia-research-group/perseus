+void ParameterGenerationCKKSRNS::MixedPrimeModuliGen(std::vector<NativeInteger>& moduliQ,
+                                                     std::vector<NativeInteger>& rootsQ, ScalingTechnique scalTech,
+                                                     uint32_t numPrimes, uint32_t firstModSize,
+                                                     const std::vector<uint32_t>& sizesPerLevel, uint32_t cyclOrder,
+                                                     uint32_t extraModSize) const {
+    // sizesPerLevel[i-1] = bit size of moduliQ[i] for i = 1..numPrimes-1 (bottom-up).
+    // Segment-aware FLEXIBLEAUTO prime selection: within a run of equal sizes the
+    // scaling-factor recursion is tracked exactly as in SinglePrimeModuliGen; at a
+    // size change the scaling-factor target resets to 2^{size}. The resulting chain
+    // only supports ct-ct multiplications within a segment; cross-segment transitions
+    // must be ct-pt operations whose plaintext encoding absorbs the scale jump
+    // (the CKKS bootstrapping circuit satisfies this by construction).
+    // Adjacent segments must differ by at least 2 bits so that the segment-boundary
+    // detection in PrecomputeCRTTables (threshold 1.5 bits) is unambiguous.
+    for (size_t i = 1; i + 1 < numPrimes; ++i) {
+        uint32_t a = sizesPerLevel[i - 1];
+        uint32_t b = sizesPerLevel[i];
+        if (a != b && (a > b ? a - b : b - a) < 2)
+            OPENFHE_THROW("scalingModSizePerLevel: adjacent segments must differ by >= 2 bits.");
+    }
+
+    uint32_t topSize       = sizesPerLevel[numPrimes - 2];
+    NativeInteger q        = FirstPrime<NativeInteger>(topSize, cyclOrder);
+    moduliQ[numPrimes - 1] = q;
+    rootsQ[numPrimes - 1]  = RootOfUnity(cyclOrder, moduliQ[numPrimes - 1]);
+
+    NativeInteger maxPrime{q};
+    NativeInteger minPrime{q};
+
+    double sf = moduliQ[numPrimes - 1].ConvertToDouble();
+    for (size_t i = numPrimes - 2, cnt = 0; i >= 1; --i, ++cnt) {
+        uint32_t sizeHere  = sizesPerLevel[i - 1];
+        uint32_t sizeAbove = sizesPerLevel[i];
+
+        if (sizeHere == sizeAbove) {
+            sf = pow(sf, 2) / moduliQ[i + 1].ConvertToDouble();
+        }
+        else {
+            // segment boundary: the ciphertext scale resets to the size class of the
+            // next prime to be consumed (ct-pt boundary op absorbs the jump)
+            sf = pow(2.0, static_cast<double>(sizeHere));
+        }
+
+        NativeInteger sfInt = std::llround(sf);
+        NativeInteger sfRem = sfInt.Mod(cyclOrder);
+        bool hasSameMod     = true;
+        if ((cnt % 2) == 0) {
+            NativeInteger qPrev = sfInt - NativeInteger(cyclOrder) - sfRem + NativeInteger(1);
+            while (hasSameMod) {
+                hasSameMod = false;
+                qPrev      = PreviousPrime(qPrev, cyclOrder);
+                for (size_t j = i + 1; j < numPrimes; j++) {
+                    if (qPrev == moduliQ[j]) {
+                        hasSameMod = true;
+                        break;
+                    }
+                }
+            }
+            moduliQ[i] = qPrev;
+        }
+        else {
+            NativeInteger qNext = sfInt + NativeInteger(cyclOrder) - sfRem + NativeInteger(1);
+            while (hasSameMod) {
+                hasSameMod = false;
+                qNext      = NextPrime(qNext, cyclOrder);
+                for (size_t j = i + 1; j < numPrimes; j++) {
+                    if (qNext == moduliQ[j]) {
+                        hasSameMod = true;
+                        break;
+                    }
+                }
+            }
+            moduliQ[i] = qNext;
+        }
+        if (moduliQ[i] > maxPrime)
+            maxPrime = moduliQ[i];
+        else if (moduliQ[i] < minPrime)
+            minPrime = moduliQ[i];
+
+        rootsQ[i] = RootOfUnity(cyclOrder, moduliQ[i]);
+    }
+
+    if (firstModSize == sizesPerLevel[0]) {  // this requires sizesPerLevel[0] < 60
+        moduliQ[0] = NextPrime<NativeInteger>(maxPrime, cyclOrder);
+    }
+    else {
+        moduliQ[0] = LastPrime<NativeInteger>(firstModSize, cyclOrder);
+
+        const auto pos = std::find(moduliQ.begin() + 1, moduliQ.end(), moduliQ[0]);
+        if (pos != moduliQ.end()) {
+            moduliQ[0] = NextPrime<NativeInteger>(maxPrime, cyclOrder);
+        }
+    }
+    if (moduliQ[0] > maxPrime)
+        maxPrime = moduliQ[0];
+
+    rootsQ[0] = RootOfUnity(cyclOrder, moduliQ[0]);
+
+    if (scalTech == FLEXIBLEAUTOEXT) {
+        auto tempMod      = FirstPrime<NativeInteger>(extraModSize - 1, cyclOrder);
+        const auto endPos = moduliQ.end() - 1;
+        auto pos          = std::find(moduliQ.begin(), endPos, tempMod);
+        moduliQ[numPrimes] = (pos != endPos) ? NextPrime<NativeInteger>(maxPrime, cyclOrder) : tempMod;
+
+        rootsQ[numPrimes] = RootOfUnity(cyclOrder, moduliQ[numPrimes]);
+    }
+}
